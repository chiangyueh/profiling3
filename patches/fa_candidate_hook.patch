+            s1BasicBlock = value;
+        }
+        if (ReadFaCandidate("FA_S2_BASE", value)) {
+            s2BasicBlock = value;
+        }
+        if (ReadFaCandidate("FA_N_RATIO", value)) {
+            nRatio = value;
+        }
+        FlashAttentionScoreTilingBase::SetCoreParams();
+        auto &coreParams = tilingData->coreParams;
+        TraceFaCandidate("FlashAttentionScoreTilingS1s2Bn2gs1", coreParams.get_s1BaseSize(),
+                         coreParams.get_s2BaseSize(), coreParams.get_nRatio());
+    }
+    // NEW END
+
