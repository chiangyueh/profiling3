@@ -30,0 +33,26 @@ namespace FA {
+static bool ReadFaCandidate(const char *name, int64_t &value)
+{
+    const char *raw = std::getenv(name);
+    if (raw == nullptr || *raw == '\0') {
+        return false;
+    }
+    char *end = nullptr;
+    const long long parsed = std::strtoll(raw, &end, 10);
+    if (end == raw || *end != '\0' || parsed <= 0) {
+        return false;
+    }
+    value = static_cast<int64_t>(parsed);
+    return true;
+}
+
+static void TraceFaCandidate(const char *name, int64_t s1Base, int64_t s2Base, int64_t nRatio)
+{
+    const char *path = std::getenv("FA_EFFECTIVE_TILING_TRACE");
+    if (path == nullptr || *path == '\0') {
+        return;
+    }
+    std::ofstream output(path, std::ios::app);
+    if (output.is_open()) {
+        output << name << '\t' << s1Base << '\t' << s2Base << '\t' << nRatio << '\n';
+    }
+}
@@ -3161,0 +3190,18 @@ protected:
