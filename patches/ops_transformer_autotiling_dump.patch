+template <typename ContextT>
+static void DumpAutotiling(const gert::TilingContextPara &tilingContextPara, ContextT *tilingContext)
+{
+    const char *enabled = std::getenv("AUTOTILING_DUMP");
+    if (enabled == nullptr || enabled[0] == '\0' || std::string(enabled) == "0") {
+        return;
+    }
+
+    const auto *testInfo = testing::UnitTest::GetInstance()->current_test_info();
+    const char *suiteName = testInfo == nullptr ? "unknown" : testInfo->test_case_name();
+    const char *testName = testInfo == nullptr ? "unknown" : testInfo->name();
+    const auto rawTilingData = tilingContext->GetRawTilingData();
+    const auto *data = static_cast<const uint8_t *>(rawTilingData->GetData());
+
+    std::ostringstream workspace;
+    const size_t workspaceCount = tilingContext->GetWorkspaceNum();
+    if (workspaceCount > 0) {
+        const auto workspaceSizes = tilingContext->GetWorkspaceSizes(workspaceCount);
+        for (size_t i = 0; i < workspaceCount; ++i) {
+            if (i != 0) {
+                workspace << ',';
+            }
+            workspace << workspaceSizes[i];
+        }
+    }
+
+    std::ostringstream hex;
+    hex << std::hex << std::setfill('0');
+    for (size_t i = 0; i < rawTilingData->GetDataSize(); ++i) {
+        hex << std::setw(2) << static_cast<unsigned int>(data[i]);
+    }
+
+    std::cout << "AUTOTILING_DUMP"
+              << "\top=" << tilingContextPara.opName_
+              << "\tcase=" << suiteName << '.' << testName
+              << "\tkey=" << tilingContext->GetTilingKey()
+              << "\tblock_dim=" << tilingContext->GetBlockDim()
+              << "\tworkspace=" << workspace.str()
+              << "\tdata_hex=" << hex.str() << std::endl;
+}
